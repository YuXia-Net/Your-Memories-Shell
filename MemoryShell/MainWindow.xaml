<?xml version="1.0" encoding="utf-8"?><Window x:Class="MemoryShell.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{local:Localize Key=S1330FC51C5C3}" xmlns:local="using:MemoryShell">
    <Grid x:Name="Root" RequestedTheme="Light" UseLayoutRounding="True" Background="{ThemeResource ShellBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideWorkspace">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="850" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="CompactWorkspace">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="500" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ProductName.Visibility" Value="Collapsed" />
                        <Setter Target="WelcomePage.Padding" Value="24,28" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="NarrowWorkspace">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ProductName.Visibility" Value="Collapsed" />
                        <Setter Target="ToolbarAbout.Visibility" Value="Collapsed" />
                        <Setter Target="WelcomePage.Padding" Value="14,20" />
                        <Setter Target="WelcomeActions.Orientation" Value="Vertical" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Border Background="{ThemeResource ShellToolbarBrush}" BorderBrush="{ThemeResource ShellLineBrush}" BorderThickness="0,0,0,1" Padding="10,0">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="ToolbarLogo" Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Image Width="20" Height="20" Source="ms-appx:///Assets/MemoryShell.png" Stretch="Uniform" IsHitTestVisible="False" />
                    <TextBlock x:Name="ProductName" Text="{local:Localize Key=S1330FC51C5C3}" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource ShellTextBrush}" />
                </StackPanel>
                <StackPanel x:Name="ToolbarCommands" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <DropDownButton Content="{local:Localize Key=ConnectionsMenu}" Style="{StaticResource ShellMenuButtonStyle}">
                        <DropDownButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="{local:Localize Key=SBEC3D896410B}" Click="QuickConnect_Click" />
                                <MenuFlyoutItem Text="{local:Localize Key=S94AA4F221201}" Click="NewProfile_Click" />
                                <MenuFlyoutItem Text="{local:Localize Key=S08BD1AD5F3C6}" Click="ConnectionManager_Click" />
                                <MenuFlyoutItem Text="{local:Localize Key=SC255841F6809}" Click="RdpMenu_Click" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutSubItem x:Name="RecentConnectionsMenu" Text="{local:Localize Key=S0B290C6600D9}" />
                                <MenuFlyoutItem Text="{local:Localize Key=S490156BE6D55}" Click="ShowHistory_Click" />
                                <MenuFlyoutItem Text="{local:Localize Key=SBA35DC23B245}" Click="ShowDeletedConnections_Click" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <DropDownButton Content="{local:Localize Key=S1C5C06713870}" Style="{StaticResource ShellMenuButtonStyle}">
                        <DropDownButton.Flyout>
                            <MenuFlyout>
                                <ToggleMenuFlyoutItem x:Name="ShowSidebar" Text="{local:Localize Key=S667FA848BD56}" IsChecked="True" Click="ToggleSidebar_Click" />
                                <MenuFlyoutItem Text="{local:Localize Key=S88B9BBD43FE4}" Click="ShowConnections_Click" />
                                <MenuFlyoutItem Text="{local:Localize Key=SC797A5342DCF}" Click="ShowMonitor_Click" />
                                <MenuFlyoutItem Text="{local:Localize Key=MonitorWallTitle}" Click="ShowMonitorWall_Click" />
                                <MenuFlyoutItem Text="{local:Localize Key=SAA8B6477C2CE}" Click="ToggleWindowFullScreen_Click" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="{local:Localize Key=S8F9F0B7B0145}" Click="ResetLayout_Click" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <DropDownButton Content="{local:Localize Key=S5CA6730D4415}" Style="{StaticResource ShellMenuButtonStyle}">
                        <DropDownButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="{local:Localize Key=S3C3A99753274}" Click="ShowRemoteDetails_Click" />
                                <MenuFlyoutItem Text="{local:Localize Key=SDAA335840030}" Click="NetworkDiagnostics_Click" />
                                <MenuFlyoutItem Text="{local:Localize Key=S68BDF6B92DF0}" Click="MultiLocationDiagnostics_Click" />
                                <MenuFlyoutSeparator />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <Button Style="{StaticResource ShellToolbarButtonStyle}" Click="Settings_Click" Content="{local:Localize Key=SettingsTitle}" />
                    <Button x:Name="ToolbarAbout" Style="{StaticResource ShellIconButtonStyle}" Click="About_Click" ToolTipService.ToolTip="{local:Localize Key=S52D25A9E30BA}" AutomationProperties.Name="{local:Localize Key=SC33025BAAD42}">
                        <FontIcon Glyph="" FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" SizeChanged="Workbench_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="252" />
                <ColumnDefinition x:Name="SidebarGripColumn" Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="SidebarPane" Background="{ThemeResource ShellPaneBrush}" BorderBrush="{ThemeResource ShellLineBrush}" BorderThickness="1" CornerRadius="8" Margin="8,8,0,8">
                <Grid x:Name="Sidebar" Padding="10,10,10,0" RowSpacing="10" ColumnSpacing="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ToggleButton x:Name="ConnectionsMode" Style="{StaticResource ShellModeButtonStyle}" Content="{local:Localize Key=SA5574109F020}" IsChecked="True" Click="ShowConnections_Click" />
                    <ToggleButton Grid.Column="1" x:Name="MonitorMode" Style="{StaticResource ShellModeButtonStyle}" Content="{local:Localize Key=SC797A5342DCF}" Click="ShowMonitor_Click" />
                    <Grid Grid.Row="1" Grid.ColumnSpan="2" x:Name="ConnectionActions" ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ConnectionFilter" AutomationProperties.Name="{local:Localize Key=S0A08FCFFA0E2}" PlaceholderText="{local:Localize Key=S74B5A598118B}" MinHeight="32" FontSize="13" TextChanged="Filter_TextChanged" />
                        <Button Grid.Column="1" Style="{StaticResource ShellIconButtonStyle}" ToolTipService.ToolTip="{local:Localize Key=S2CB204A57873}" AutomationProperties.Name="{local:Localize Key=S4B874B8CFCCF}">
                            <Button.Flyout><MenuFlyout>
                                <MenuFlyoutItem Text="{local:Localize Key=S94AA4F221201}" Click="NewProfile_Click" />
                                <MenuFlyoutItem Text="{local:Localize Key=S3D49D9FCB6D1}" Click="CreateDeviceGroup_Click" />
                            </MenuFlyout></Button.Flyout>
                            <FontIcon Glyph="" FontSize="13" />
                        </Button>
                    </Grid>
                    <ListView Grid.Row="2" Grid.ColumnSpan="2" x:Name="Profiles" IsItemClickEnabled="False" AutomationProperties.Name="{local:Localize Key=SD740B22024CC}" CanDragItems="True" DragItemsStarting="Profiles_DragItemsStarting">
                        <ListView.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="{local:Localize Key=S94AA4F221201}" Click="NewProfile_Click" />
                                <MenuFlyoutItem Text="{local:Localize Key=S3D49D9FCB6D1}" Click="CreateDeviceGroup_Click" />
                            </MenuFlyout>
                        </ListView.ContextFlyout>
                    </ListView>
                    <ScrollViewer Grid.Row="1" Grid.RowSpan="2" Grid.ColumnSpan="2" x:Name="MonitorPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="8" Padding="1,4,0,12">
                            <Button x:Name="MonitorDetails" Style="{StaticResource ShellToolbarButtonStyle}" Content="{local:Localize Key=S3FA4B23D8BCE}" Click="ShowRemoteDetails_Click" HorizontalAlignment="Stretch" IsEnabled="False" />
                            <ContentControl x:Name="Metrics" HorizontalContentAlignment="Stretch" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
            <Border x:Name="SidebarGrip" Grid.Column="1" Background="{ThemeResource ShellToolbarBrush}" PointerPressed="SidebarGrip_PointerPressed" PointerMoved="SidebarGrip_PointerMoved" PointerReleased="SidebarGrip_PointerReleased" PointerCaptureLost="SidebarGrip_PointerCaptureLost" DoubleTapped="SidebarGrip_DoubleTapped" ToolTipService.ToolTip="{local:Localize Key=S00484A2C5FEC}" />
            <Grid Grid.Column="2" Background="{ThemeResource ShellBaseBrush}" Margin="4,8,8,8">
                <TabView x:Name="Sessions" VerticalAlignment="Stretch" CanReorderTabs="True" CanDragTabs="True" IsAddTabButtonVisible="True" AddTabButtonClick="Sessions_AddTabButtonClick" Background="{ThemeResource ShellToolbarBrush}" TabWidthMode="SizeToContent" TabCloseRequested="Sessions_TabCloseRequested" SelectionChanged="Sessions_SelectionChanged">
                    <TabView.TabStripHeader>
                        <Border Margin="4,3,6,3" Padding="0,0,5,0" VerticalAlignment="Bottom" BorderBrush="{ThemeResource ShellLineBrush}" BorderThickness="0,0,1,0">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Button x:Name="SidebarToggle" Style="{StaticResource ShellIconButtonStyle}" Click="ToggleSidebar_Click" ToolTipService.ToolTip="{local:Localize Key=CollapseSidebar}" AutomationProperties.Name="{local:Localize Key=CollapseSidebar}">
                                    <FontIcon Glyph="&#xE8A0;" FontSize="16" />
                                </Button>

                            </StackPanel>
                        </Border>
                    </TabView.TabStripHeader>
                    <TabViewItem x:Name="StartTab" Header="{local:Localize Key=S9C5D341609CD}" IsClosable="True" Tag="start">
                        <Grid x:Name="Welcome" Background="{ThemeResource ShellBaseBrush}">
                            <ScrollViewer x:Name="WelcomePage" Padding="28,24" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalContentAlignment="Stretch">
                                <StackPanel MaxWidth="960" Spacing="20" HorizontalAlignment="Stretch">
                                    <Border Background="{ThemeResource ShellCardBrush}" BorderBrush="{ThemeResource ShellLineBrush}" BorderThickness="1" CornerRadius="12" Padding="22">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="{local:Localize Key=S66AF5915CC75}" FontSize="28" FontWeight="SemiBold" />
                                        <StackPanel x:Name="WelcomeActions" Orientation="Horizontal" Spacing="8">
                                            <Button Style="{StaticResource ShellPrimaryButtonStyle}" Content="{local:Localize Key=S94AA4F221201}" Click="NewProfile_Click" />
                                            <Button Style="{StaticResource ShellToolbarButtonStyle}" Content="{local:Localize Key=SBEC3D896410B}" Click="QuickConnect_Click" />
                                            <Button Style="{StaticResource ShellToolbarButtonStyle}" Content="{local:Localize Key=SC255841F6809}" Click="RdpMenu_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                    </Border>
                                    <Border Background="{ThemeResource ShellCardBrush}" BorderBrush="{ThemeResource ShellLineBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                                    <StackPanel Spacing="12">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{local:Localize Key=S0B290C6600D9}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <HyperlinkButton Grid.Column="1" Content="{local:Localize Key=SE42579208480}" Click="ShowHistory_Click" HorizontalAlignment="Right" Padding="4,2" FontSize="12" />
                                        </Grid>
                                        <Border BorderBrush="{ThemeResource ShellLineBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                            <Grid MinHeight="58">
                                                <ListView x:Name="WelcomeRecent" HorizontalContentAlignment="Stretch" ScrollViewer.VerticalScrollBarVisibility="Disabled" IsItemClickEnabled="False" SelectionMode="Single" AutomationProperties.Name="{local:Localize Key=S0B290C6600D9}" />
                                                <TextBlock x:Name="WelcomeEmpty" Text="{local:Localize Key=S8475013DA87C}" Margin="8,12" Foreground="{ThemeResource ShellMutedBrush}" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                    </Border>
                                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="20,14" Click="ShowMonitorWall_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE9D9;" /><TextBlock Text="{local:Localize Key=MonitorWallTitle}" VerticalAlignment="Center" FontWeight="SemiBold" /></StackPanel>
                                    </Button>
                                    <Border Background="{ThemeResource ShellCardBrush}" BorderBrush="{ThemeResource ShellLineBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                                    <Grid ColumnSpacing="24">
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="{local:Localize Key=SA5574109F020}" FontSize="13" FontWeight="SemiBold" />
                                            <HyperlinkButton Content="{local:Localize Key=S117EEFEED30E}" Click="ConnectionManager_Click" Padding="0,3" />
                                            <HyperlinkButton Content="{local:Localize Key=S3D49D9FCB6D1}" Click="CreateDeviceGroup_Click" Padding="0,3" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="6">
                                            <TextBlock Text="{local:Localize Key=SDF3D58C7D84B}" FontSize="13" FontWeight="SemiBold" />
                                            <HyperlinkButton Content="{local:Localize Key=S64B3BCB55412}" Click="AppearanceSettings_Click" Padding="0,3" />
                                            <HyperlinkButton Content="{local:Localize Key=SCB957C6CC0EB}" Click="VaultOverview_Click" Padding="0,3" />
                                        </StackPanel>
                                    </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </TabViewItem>
                </TabView>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="{ThemeResource ShellToolbarBrush}" BorderBrush="{ThemeResource ShellLineBrush}" BorderThickness="0,1,0,0" Padding="10,0">
            <Grid ColumnSpacing="9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse Width="6" Height="6" Fill="{ThemeResource ShellAccentBrush}" VerticalAlignment="Center" />
                <ContentControl x:Name="ProjectLinkHost" Grid.Column="2" />
                <TextBlock Grid.Column="1" x:Name="Status" Text="{local:Localize Key=SB073DB9C0BD6}" VerticalAlignment="Center" Foreground="{ThemeResource ShellMutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>
    </Grid>
</Window>






