<?xml version="1.0" encoding="utf-8"?><Application x:Class="MemoryShell.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:MemoryShell">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ShellBaseBrush" Color="#0C121E" />
                    <SolidColorBrush x:Key="ShellToolbarBrush" Color="#18253A" />
                    <SolidColorBrush x:Key="ShellPaneBrush" Color="#131E30" />
                    <SolidColorBrush x:Key="ShellCardBrush" Color="#1D2D46" />
                    <SolidColorBrush x:Key="ShellLineBrush" Color="#30435A" />
                    <SolidColorBrush x:Key="ShellTextBrush" Color="#EEF4FF" />
                    <SolidColorBrush x:Key="ShellMutedBrush" Color="#A8B7CD" />
                    <SolidColorBrush x:Key="ShellAccentBrush" Color="#83D6FF" />
                    <SolidColorBrush x:Key="ShellActionBrush" Color="#8FD8FF" />
                    <SolidColorBrush x:Key="ShellActionTextBrush" Color="#0C263C" />
                    <SolidColorBrush x:Key="ShellErrorBrush" Color="#FFABA0" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ShellBaseBrush" Color="#F8F8F8" />
                    <SolidColorBrush x:Key="ShellToolbarBrush" Color="#F0F0F0" />
                    <SolidColorBrush x:Key="ShellPaneBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ShellCardBrush" Color="#F5F5F5" />
                    <SolidColorBrush x:Key="ShellLineBrush" Color="#E0E0E0" />
                    <SolidColorBrush x:Key="ShellTextBrush" Color="#1B1B1B" />
                    <SolidColorBrush x:Key="ShellMutedBrush" Color="#525252" />
                    <SolidColorBrush x:Key="ShellAccentBrush" Color="#005FB8" />
                    <SolidColorBrush x:Key="ShellActionBrush" Color="#005FB8" />
                    <SolidColorBrush x:Key="ShellActionTextBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ShellErrorBrush" Color="#9C2528" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="ShellBaseBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="ShellToolbarBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="ShellPaneBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="ShellCardBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="ShellLineBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="ShellTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="ShellMutedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="ShellAccentBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="ShellActionBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="ShellActionTextBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="ShellErrorBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="ShellRailToggleStyle" TargetType="ToggleButton">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <Style x:Key="ShellRailButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <Style x:Key="ShellLaunchCardStyle" TargetType="Button">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Padding" Value="18,14" />
                <Setter Property="Margin" Value="0,0,10,10" />
                <Setter Property="CornerRadius" Value="10" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="10,4" />
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="10,7" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>
            <Style TargetType="PasswordBox">
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="10,7" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>
            <Style TargetType="TabViewItem">
                <Setter Property="FontSize" Value="13" />
            </Style>
            <DataTemplate x:Key="RemoteFileRowTemplate">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="55" />
                        <ColumnDefinition Width="54" />
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="124" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name, Mode=OneTime}" FontSize="12" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding Size, Mode=OneTime}" FontSize="12" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="{Binding Kind, Mode=OneTime}" FontSize="12" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="3" Text="{Binding Mode, Mode=OneTime}" FontSize="12" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="4" Text="{Binding Owner, Mode=OneTime}" FontSize="12" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="5" Text="{Binding Modified, Mode=OneTime}" FontSize="12" TextTrimming="CharacterEllipsis" />
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="RemoteFileRowExplorerTemplate">
                <Grid ColumnSpacing="10" MinHeight="32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="152" />
                    </Grid.ColumnDefinitions>
                    <SymbolIcon Symbol="{Binding Icon, Mode=OneTime}" Foreground="{ThemeResource ShellAccentBrush}" />
                    <TextBlock Grid.Column="1" Text="{Binding Name, Mode=OneTime}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="{Binding Size, Mode=OneTime}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="3" Text="{Binding Kind, Mode=OneTime}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="4" Text="{Binding Modified, Mode=OneTime}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="RemoteFileRowCompactTemplate">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="65" />
                        <ColumnDefinition Width="112" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name, Mode=OneTime}" FontSize="12" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding Size, Mode=OneTime}" FontSize="12" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="{Binding Modified, Mode=OneTime}" FontSize="12" TextTrimming="CharacterEllipsis" />
                </Grid>
            </DataTemplate>

            <Style x:Key="ShellToolbarButtonStyle" TargetType="Button">
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="Padding" Value="8,3" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="FontSize" Value="12" />
            </Style>
            <Style x:Key="ShellPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="Padding" Value="9,3" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Background" Value="{ThemeResource ShellActionBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource ShellActionTextBrush}" />
            </Style>
            <Style x:Key="ShellMenuButtonStyle" TargetType="DropDownButton">
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="Padding" Value="8,3" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="FontSize" Value="12" />
            </Style>
            <Style x:Key="ShellIconButtonStyle" TargetType="Button" BasedOn="{StaticResource ShellToolbarButtonStyle}">
                <Setter Property="Width" Value="30" />
                <Setter Property="Height" Value="30" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{ThemeResource ShellAccentBrush}" />
            </Style>
            <Style x:Key="ShellModeButtonStyle" TargetType="ToggleButton">
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Padding" Value="8,3" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>




