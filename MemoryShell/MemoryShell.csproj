<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Platform>x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Product>你的记忆Shell终端</Product>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <ApplicationIcon>Assets\MemoryShell.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Localization\*.json" Exclude="Localization\references.json">
      <WithCulture>false</WithCulture>
      <LogicalName>MemoryShell.Localization.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <ProjectReference Include="..\MemoryShell.Media\MemoryShell.Media.csproj" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.5.240607001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.22621.756" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.33" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <Content Include="Assets\MemoryShell.png;Assets\MemoryShell.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\Distros\*.svg" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RefreshWinUIManifestMode" BeforeTargets="CreateWinRTRegistration"
          DependsOnTargets="GetNewAppManifestValues" Condition="'$(WindowsAppSDKSelfContained)' == 'true'">
    <PropertyGroup>
      <WinUIManifestMode>folder</WinUIManifestMode>
      <WinUIManifestMode Condition="'$(PublishSingleFile)' == 'true'">single-file</WinUIManifestMode>
      <WinUIManifestModeFile>$(SelfContainedIntermediateOutputPath)Manifests\build-mode.txt</WinUIManifestModeFile>
    </PropertyGroup>
    <ReadLinesFromFile File="$(WinUIManifestModeFile)" Condition="Exists('$(WinUIManifestModeFile)')">
      <Output TaskParameter="Lines" PropertyName="PreviousWinUIManifestMode" />
    </ReadLinesFromFile>
    <Delete Files="$(ApplicationManifest)" Condition="'$(PreviousWinUIManifestMode)' != '$(WinUIManifestMode)'" />
    <MakeDir Directories="$(SelfContainedIntermediateOutputPath)Manifests" />
    <WriteLinesToFile File="$(WinUIManifestModeFile)" Lines="$(WinUIManifestMode)" Overwrite="true"
                      Condition="'$(PreviousWinUIManifestMode)' != '$(WinUIManifestMode)'" />
    <ItemGroup>
      <FileWrites Include="$(WinUIManifestModeFile);$(ApplicationManifest);$(SelfContainedIntermediateOutputPath)Manifests\WindowsAppSDK.manifest" />
    </ItemGroup>
  </Target>
  <Target Name="ReadGitRevision" BeforeTargets="CoreCompile">
    <ReadLinesFromFile File="$(MSBuildProjectDirectory)\..\BuildRevision.txt" Condition="Exists('$(MSBuildProjectDirectory)\..\BuildRevision.txt')">
      <Output TaskParameter="Lines" PropertyName="GitRevision" />
    </ReadLinesFromFile>
    <Exec Condition="Exists('$(MSBuildProjectDirectory)\..\.git')" Command="git rev-parse --short=10 HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitRevision" />
    </Exec>
    <PropertyGroup><GitRevision Condition="'$(GitRevision)' == ''">uncommitted</GitRevision></PropertyGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)GitBuild.g.cs"
      Lines="[assembly: System.Reflection.AssemblyMetadata(&quot;Build&quot;, &quot;$(GitRevision)&quot;)]"
      Overwrite="true" />
    <ItemGroup><Compile Include="$(IntermediateOutputPath)GitBuild.g.cs" /></ItemGroup>
  </Target>
</Project>
